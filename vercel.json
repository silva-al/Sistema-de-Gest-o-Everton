{
  "version": 2,
  "buildCommand": "node scripts/build-netlify.js",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/admin.*",
      "dest": "/admin/index.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
