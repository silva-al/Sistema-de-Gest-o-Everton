# Copie este arquivo para ".env" e preencha com os seus valores reais.
# NUNCA suba o arquivo ".env" (com os valores reais) para um repositório público.

# Connection string do banco Postgres do Supabase.
# No Supabase: Project Settings > Database > Connection string (modo "URI").
DATABASE_URL=postgres://usuario:senha@host:5432/postgres

# Segredo usado para assinar os tokens de login (JWT). Use um texto longo e aleatório.
JWT_SECRET=troque_este_valor_por_um_segredo_bem_grande_e_aleatorio

# Porta em que o servidor vai rodar (o Render define isso sozinho em produção).
PORT=3000

# ===================================================================
# CONFIGURAÇÕES ADICIONAIS (Opcionais - o sistema opera em Sandbox/Mock se vazios)
# ===================================================================

# 1. Pagamentos Pix e Cartão:
# Opção A: Token de produção do Mercado Pago (obtido em: https://www.mercadopago.com.br/developers/panel/app)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-token-aqui
# Public key da MESMA aplicação do Mercado Pago. É ela que o navegador usa para montar o
# formulário de cartão (Checkout Bricks). Sem ela o site esconde a opção "Cartão".
# Pode aparecer no site do cliente — o ACCESS_TOKEN acima é que nunca pode.
MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-public-key-aqui
# Opção B: Chave Pix direta da sua conta bancária/empresa (CNPJ, e-mail, celular ou chave aleatória)
PIX_KEY=sua-chave-pix-aqui

# 2. Consulta Veicular por Placa:
# Token do provedor veicular (ex: WDAPI2, APIBrasil ou compatíveis).
VEHICLE_API_TOKEN=seu-token-de-consulta-aqui
VEHICLE_API_URL=https://wdapi2.com.br/consulta
